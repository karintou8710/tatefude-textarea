{
  "name": "canvas-vert-textarea",
  "version": "0.0.0",
  "description": "canvas \u306b\u81ea\u524d\u3067\u7d44\u3080\u7e26\u66f8\u304d\u306e\u30c6\u30ad\u30b9\u30c8\u30a8\u30ea\u30a2",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./dom": "./src/dom.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./dom": {
        "types": "./dist/dom.d.ts",
        "default": "./dist/dom.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run"
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.61.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.10"
  },
  "sideEffects": false
}
